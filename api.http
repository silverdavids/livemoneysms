@baseUrl = http://127.0.0.1:3000
@contentType = application/json

###
# Log in
POST {{baseUrl}}/api/login
Content-Type: {{contentType}}

{
  "username": "admin",
  "password": "pwd123"
}

###
# Manual check: smart bet login should normalize to 256708898054 and require password change
POST {{baseUrl}}/api/login
Content-Type: {{contentType}}

{
  "username": "0708898054",
  "password": "<plain-password-for-the-stored-bcrypt-hash>"
}

###
# Manual check: canonical smart bet username should behave the same way
POST {{baseUrl}}/api/login
Content-Type: {{contentType}}

{
  "username": "256708898054",
  "password": "<plain-password-for-the-stored-bcrypt-hash>"
}

###
# Complete forced password change after either smart bet login
POST {{baseUrl}}/api/change-password
Content-Type: {{contentType}}

{
  "password": "<new-password>",
  "confirmPassword": "<new-password>"
}

###
# Current session user
GET {{baseUrl}}/api/me

###
# Recent messages for the logged-in user
GET {{baseUrl}}/api/messages?top=50

###
# Devices visible to the logged-in user
GET {{baseUrl}}/api/devices

###
# Assign a device to a user
# Requires an authenticated user with CanViewAllDevices = 1
POST {{baseUrl}}/api/user-devices
Content-Type: {{contentType}}

{
  "userId": "558D4987-BC73-4AA6-894D-8CA80F944D7E",
  "deviceId": "0a0d88af8c602c19",
  "isActive": true
}

###
# Log out
POST {{baseUrl}}/api/logout
